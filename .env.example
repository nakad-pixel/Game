# Frontend Environment Variables
# Copy this file to .env.local and fill in your values

# Backend API URL (optional - for cloud saves and leaderboards)
VITE_API_URL=http://localhost:3001

# Analytics (optional)
VITE_ANALYTICS_ID=

# AdMob Configuration (optional - for real ad integration)
VITE_ADMOB_APP_ID=
VITE_ADMOB_BANNER_ID=
VITE_ADMOB_INTERSTITIAL_ID=
VITE_ADMOB_REWARDED_ID=

# Stripe (optional - for real payments)
VITE_STRIPE_PUBLIC_KEY=

# Feature Flags
VITE_ENABLE_CLOUD_SAVES=false
VITE_ENABLE_LEADERBOARDS=false
VITE_ENABLE_ADS=false
